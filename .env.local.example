# ────────────────────────────────────────────
# 이 파일을 복사해서 .env.local 파일을 만드세요
# cp .env.local.example .env.local
# ────────────────────────────────────────────

# NextAuth 설정
NEXTAUTH_URL=http://localhost:3000
# 아래 명령어로 랜덤 시크릿 생성: openssl rand -base64 32
NEXTAUTH_SECRET=여기에_랜덤_32자_문자열_입력

# Google OAuth (Google Cloud Console에서 발급)
GOOGLE_CLIENT_ID=여기에_구글_클라이언트_ID
GOOGLE_CLIENT_SECRET=여기에_구글_클라이언트_시크릿

# Google Sheets (스프레드시트 URL의 /d/ 이후 ~ /edit 이전 부분)
GOOGLE_SHEET_ID=여기에_스프레드시트_ID

# 서비스 계정 JSON 키 (한 줄 문자열로 변환해서 입력)
# 변환 방법: cat service-account.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}
